      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-demo"
          },
          "editorType": "sql",
          "rawSql": "-- One row per sensor: its newest reading in the last day, so a sensor that went quiet\n-- still shows up (as offline) instead of disappearing from the plan.\nSELECT\n  sensor,\n  max(time) AS last_seen,\n  argMax(location, time) AS location,\n  argMax(temperature, time) AS temperature,\n  argMax(humidity, time) AS humidity,\n  argMax(co2, time) AS co2,\n  argMax(temperature_limits, time) AS temperature_limits,\n  argMax(humidity_limits, time) AS humidity_limits\nFROM climate.readings\nWHERE time > now() - INTERVAL 1 DAY\nGROUP BY sensor",
          "format": 1,
          "queryType": "table"
        }
      ]
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-demo"
      },
      "gridPos": {
        "h": 14,
