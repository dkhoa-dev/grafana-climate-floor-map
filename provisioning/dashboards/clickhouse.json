      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-demo"
          },
          "editorType": "sql",
          "rawSql": "SELECT time, sensor, location, temperature, humidity, co2, temperature_limits, humidity_limits\nFROM climate.readings\nWHERE $__timeFilter(time)\nORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ]
    }
