{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "panel",
  "name": "Climate Floor Map",
  "id": "dkhoa-climatefloormap-panel",
  "info": {
    "keywords": ["floor plan", "svg", "temperature", "humidity", "iot", "building"],
