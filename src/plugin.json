    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Source",
        "url": "https://github.com/dkhoa-dev/grafana-climate-floor-map"
      },
      {
        "name": "License",
        "url": "https://github.com/dkhoa-dev/grafana-climate-floor-map/blob/main/LICENSE"
      }
    ],
    "screenshots": [
      {
        "name": "Demo dashboard",
        "path": "img/screenshot.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
